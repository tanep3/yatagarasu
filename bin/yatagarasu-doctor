#!/bin/bash
# Yatagarasu Doctor - runtime environment diagnostics

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
if [[ -z "${YATAGARASU_CWD:-}" ]]; then
    export YATAGARASU_CWD="$PROJECT_ROOT/workspace"
fi

VERBOSE=false
CHECK_LOGS=true
CHECK_SERVICES=true
FAIL_COUNT=0
WARN_COUNT=0
ENV_FILE=""

usage() {
    cat <<EOF
使用法: yatagarasu doctor [オプション]

オプション:
  --verbose       詳細情報を表示
  --no-logs       systemdログ確認をスキップ
  --no-services   systemdサービス確認をスキップ
  -h, --help      ヘルプを表示
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose)
            VERBOSE=true
            shift
            ;;
        --no-logs)
            CHECK_LOGS=false
            shift
            ;;
        --no-services)
            CHECK_SERVICES=false
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "不明なオプション: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

load_env_file() {
    local workspace="${YATAGARASU_CWD:-$PROJECT_ROOT/workspace}"
    local env_file=""

    if [[ -f "${workspace}/.env" ]]; then
        env_file="${workspace}/.env"
    elif [[ -f "${PROJECT_ROOT}/.env" ]]; then
        env_file="${PROJECT_ROOT}/.env"
    fi

    ENV_FILE="$env_file"

    if [[ -f "$env_file" ]]; then
        while IFS='=' read -r key value; do
            [[ "$key" =~ ^#.*$ ]] && continue
            [[ -z "$key" ]] && continue
            value=$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//;s/^'"'"'//;s/'"'"'$//')
            [[ -z "${!key:-}" ]] && export "${key}=${value}"
        done < "$env_file"
    fi
}

ok() {
    printf '[OK]   %s\n' "$*"
}

warn() {
    WARN_COUNT=$((WARN_COUNT + 1))
    printf '[WARN] %s\n' "$*"
}

fail() {
    FAIL_COUNT=$((FAIL_COUNT + 1))
    printf '[FAIL] %s\n' "$*"
}

info() {
    printf '[INFO] %s\n' "$*"
}

find_cmd() {
    local name="$1"
    local found

    found="$(command -v "$name" 2>/dev/null || true)"
    if [[ -n "$found" ]]; then
        printf '%s' "$found"
        return 0
    fi

    if [[ "$name" == "codex" ]]; then
        for candidate in "$HOME"/.nvm/versions/node/*/bin/codex; do
            if [[ -x "$candidate" ]]; then
                printf '%s' "$candidate"
                return 0
            fi
        done
    fi

    return 1
}

http_probe() {
    local url="$1"
    local timeout="${2:-2}"
    local token="${3:-}"
    HOSHIKAGE_PROBE_TOKEN="$token" python3 - "$url" "$timeout" <<'PY'
import os
import sys
import urllib.error
import urllib.request

url = sys.argv[1]
timeout = float(sys.argv[2])
headers = {}
token = os.environ.get("HOSHIKAGE_PROBE_TOKEN", "")
if token:
    headers["Authorization"] = f"Bearer {token}"
request = urllib.request.Request(url, headers=headers)
try:
    with urllib.request.urlopen(request, timeout=timeout) as res:
        body = res.read(160)
        print(f"{res.status} {body.decode('utf-8', errors='ignore').strip()}")
except Exception as exc:
    print(str(exc), file=sys.stderr)
    sys.exit(1)
PY
}

check_command() {
    local label="$1"
    local cmd="$2"
    local path

    if path="$(find_cmd "$cmd")"; then
        ok "$label: $path"
        return 0
    fi

    fail "$label: command not found ($cmd)"
    return 1
}

check_optional_command() {
    local label="$1"
    local cmd="$2"
    local path

    if path="$(find_cmd "$cmd")"; then
        ok "$label: $path"
    else
        info "$label: not installed (optional)"
    fi
}

check_agent_commands() {
    local engine="$1"
    local available=0
    local path

    case "$engine" in
        auto)
            for command in codex claude opencode; do
                if path="$(find_cmd "$command")"; then
                    ok "$command: $path"
                    available=$((available + 1))
                else
                    info "$command: not installed (optional)"
                fi
            done
            if [[ "$available" -eq 0 ]]; then
                fail "agent CLI: codex, claude, or opencode is required"
            fi
            ;;
        codex)
            check_command "codex" "codex"
            check_optional_command "claude" "claude"
            check_optional_command "opencode" "opencode"
            ;;
        claude)
            check_optional_command "codex" "codex"
            check_command "claude" "claude"
            check_optional_command "opencode" "opencode"
            ;;
        opencode)
            check_optional_command "codex" "codex"
            check_optional_command "claude" "claude"
            check_command "opencode" "opencode"
            ;;
    esac
}

check_executable() {
    local label="$1"
    local path="$2"

    if [[ -x "$path" ]]; then
        ok "$label: $path"
    else
        fail "$label: executable not found ($path)"
    fi
}

check_git_env() {
    local workspace="$1"
    local env_path="${workspace}/.env"

    if ! command -v git >/dev/null 2>&1; then
        warn "git: command not found; .envの追跡状態を確認できません"
        return
    fi

    if git -C "$PROJECT_ROOT" ls-files --error-unmatch "$env_path" >/dev/null 2>&1; then
        fail "workspace/.env is tracked by git"
        return
    fi

    if git -C "$PROJECT_ROOT" check-ignore -q "$env_path" 2>/dev/null; then
        ok "workspace/.env: ignored by git"
    else
        warn "workspace/.env: not tracked, but not ignored"
    fi
}

check_codex_model() {
    local model="$1"
    local cache="$HOME/.codex/models_cache.json"

    if [[ -z "$model" ]]; then
        info "codex model: Codex CLI default"
        return
    fi

    if [[ ! -f "$cache" ]]; then
        warn "codex model: $model (models_cache.json not found)"
        return
    fi

    if python3 - "$cache" "$model" <<'PY'
import json
import sys
from pathlib import Path

cache = Path(sys.argv[1])
target = sys.argv[2]
data = json.loads(cache.read_text())
models = data.get("models", [])
sys.exit(0 if any(m.get("slug") == target for m in models) else 1)
PY
    then
        ok "codex model: $model is in local cache"
    else
        warn "codex model: $model is not in local cache"
    fi
}

check_codex_profile() {
    local profile="$1"
    local codex_home="${CODEX_HOME:-$HOME/.codex}"
    local profile_path
    local details
    local fields
    local model
    local provider_id
    local base_url
    local wire_api
    local env_key
    local network_access
    local token=""
    local ready_base
    local ready_url
    local output

    if [[ -z "$profile" ]]; then
        info "codex profile: Codex CLI default"
        return
    fi

    profile_path="$codex_home/${profile}.config.toml"
    if [[ ! -f "$profile_path" ]]; then
        fail "codex profile not found: $profile_path"
        return
    fi
    ok "codex profile: $profile"

    if ! details="$(python3 - "$profile_path" <<'PY'
import sys
import tomllib
from pathlib import Path

path = Path(sys.argv[1])
data = tomllib.loads(path.read_text())
provider_id = data.get("model_provider", "")
provider = data.get("model_providers", {}).get(provider_id, {})
print(data.get("model", ""))
print(provider_id)
print(provider.get("base_url", ""))
print(provider.get("wire_api", ""))
print(provider.get("env_key", ""))
print(str(data.get("sandbox_workspace_write", {}).get("network_access", False)).lower())
PY
    )"; then
        fail "codex profile is invalid TOML: $profile_path"
        return
    fi

    mapfile -t fields <<<"$details"
    model="${fields[0]:-}"
    provider_id="${fields[1]:-}"
    base_url="${fields[2]:-}"
    wire_api="${fields[3]:-}"
    env_key="${fields[4]:-}"
    network_access="${fields[5]:-false}"

    info "codex profile model: ${model:-"(not set)"}"
    if [[ "$provider_id" != "hoshikage" ]]; then
        info "codex profile provider: ${provider_id:-"(not set)"} (Hoshikage probe skipped)"
        return
    fi

    if [[ "$wire_api" == "responses" ]]; then
        ok "Hoshikage provider: responses"
    else
        fail "Hoshikage provider wire_api must be responses"
        return
    fi

    if [[ -z "$base_url" ]]; then
        fail "Hoshikage provider base_url is not configured"
        return
    fi

    if [[ "$network_access" == "true" ]]; then
        ok "Codex sandbox network: enabled"
    else
        fail "Codex sandbox network must be enabled for network-backed Skills"
    fi

    if [[ -n "$env_key" ]]; then
        token="${!env_key:-}"
        if [[ -z "$token" ]]; then
            fail "Hoshikage token environment variable is not set: $env_key"
            return
        fi
        ok "Hoshikage token: configured ($env_key)"
    else
        info "Hoshikage token: not required by profile"
    fi

    ready_base="${base_url%/}"
    ready_base="${ready_base%/v1}"
    ready_url="${ready_base}/ready"
    if output="$(http_probe "$ready_url" 2 "$token" 2>&1)"; then
        ok "Hoshikage ready: $ready_url ($output)"
    else
        fail "Hoshikage ready: cannot reach $ready_url ($output)"
    fi
}

check_livekit_wakeword() {
    local python_bin="$PROJECT_ROOT/python/.venv/bin/python"
    local model_path="${LISTEND_WAKE_MODEL_PATH:-}"
    local prompt_path="${LISTEND_WAKE_PROMPT_AUDIO:-}"
    local expected_model_hash=""
    local expected_prompt_hash=""
    local output

    info "wake backend: $LISTEND_WAKE_BACKEND"
    if [[ "$LISTEND_WAKE_BACKEND" == "stt" ]]; then
        ok "wake backend value: stt (compatibility mode)"
        info "wake words: ${LISTEND_WAKE_WORDS:-"(not set)"}"
        return
    fi
    if [[ "$LISTEND_WAKE_BACKEND" != "livekit" ]]; then
        fail "wake backend is unsupported: $LISTEND_WAKE_BACKEND"
        return
    fi

    if [[ -z "$model_path" ]]; then
        model_path="$PROJECT_ROOT/models/wakeword/nee_yatagarasu.onnx"
        expected_model_hash="0a2926bf00ff15c24e6ed0cf09e60e5550339439db5103335a517d9d0a70feb8"
    elif [[ "$model_path" != /* ]]; then
        model_path="$WORKSPACE/$model_path"
    fi
    if [[ -z "$prompt_path" ]]; then
        prompt_path="$PROJECT_ROOT/assets/audio/wake_prompt_hai.wav"
        expected_prompt_hash="098ecc8053a169d61f33742f9603f516e1928a444b71acf6d5b2759e1e0ac0e1"
    elif [[ "$prompt_path" != /* ]]; then
        prompt_path="$WORKSPACE/$prompt_path"
    fi

    if [[ ! -x "$python_bin" ]]; then
        fail "wake runtime: Python environment not found ($python_bin)"
        return
    fi

    if output="$("$python_bin" - "$model_path" "$prompt_path" "$expected_model_hash" "$expected_prompt_hash" "$PROJECT_ROOT/python" <<'PY' 2>&1
import hashlib
import stat
import sys
from pathlib import Path

import numpy as np
import onnxruntime as ort

model_path = Path(sys.argv[1])
prompt_path = Path(sys.argv[2])
expected_model_hash = sys.argv[3]
expected_prompt_hash = sys.argv[4]
sys.path.insert(0, sys.argv[5])

from wakeword import build_cpu_predictor

def validate_asset(path: Path, expected_hash: str) -> str:
    if not path.is_file():
        raise RuntimeError(f"asset not found: {path}")
    mode = stat.S_IMODE(path.stat().st_mode)
    if mode != 0o644:
        raise RuntimeError(f"asset mode must be 0644: {path} ({mode:o})")
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if expected_hash and digest != expected_hash:
        raise RuntimeError(f"asset SHA-256 mismatch: {path}")
    return digest

model_hash = validate_asset(model_path, expected_model_hash)
prompt_hash = validate_asset(prompt_path, expected_prompt_hash)
if "CPUExecutionProvider" not in ort.get_available_providers():
    raise RuntimeError("CPUExecutionProvider is unavailable")

classifier = ort.InferenceSession(
    str(model_path),
    providers=["CPUExecutionProvider"],
)
input_meta = classifier.get_inputs()[0]
output_meta = classifier.get_outputs()[0]
if input_meta.shape != ["batch", 16, 96] and input_meta.shape != [None, 16, 96]:
    raise RuntimeError(f"unexpected classifier input shape: {input_meta.shape}")
if output_meta.shape != ["batch", 1] and output_meta.shape != [None, 1]:
    raise RuntimeError(f"unexpected classifier output shape: {output_meta.shape}")

predict = build_cpu_predictor(model_path)
scores = predict(np.zeros(32_000, dtype=np.int16))
score = scores.get(model_path.stem)
if score is None or not np.isfinite(score) or not 0.0 <= score <= 1.0:
    raise RuntimeError(f"invalid smoke inference score: {scores}")

print(f"model={model_path}")
print(f"model_sha256={model_hash}")
print(f"prompt={prompt_path}")
print(f"prompt_sha256={prompt_hash}")
print(f"provider=CPUExecutionProvider")
print(f"smoke_score={score:.6f}")
PY
    )"; then
        ok "LiveKit WakeWord runtime and bundled assets"
        while IFS= read -r line; do
            info "$line"
        done <<<"$output"
    else
        fail "LiveKit WakeWord runtime: $output"
    fi
}

print_header() {
    cat <<EOF
Yatagarasu Doctor
=================
EOF
}

load_env_file
USER_LOCAL_BIN="${HOME:-}/.local/bin"
if [[ -d "$USER_LOCAL_BIN" && ":$PATH:" != *":$USER_LOCAL_BIN:"* ]]; then
    export PATH="$USER_LOCAL_BIN:$PATH"
fi
WORKSPACE="${YATAGARASU_CWD:-$PROJECT_ROOT/workspace}"
ENGINE="${YATAGARASU_ENGINE:-auto}"
MODEL="${YATAGARASU_MODEL:-}"
CODEX_MODEL="${YATAGARASU_CODEX_MODEL:-}"
CODEX_PROFILE="${YATAGARASU_CODEX_PROFILE:-}"
CODEX_REASONING_EFFORT="${YATAGARASU_CODEX_REASONING_EFFORT:-}"
CODEX_BYPASS_SANDBOX="${YATAGARASU_CODEX_BYPASS_SANDBOX:-false}"
GO2RTC_HOST="${GO2RTC_HOST:-localhost}"
GO2RTC_API_PORT="${GO2RTC_API_PORT:-1984}"
VOICEVOX_ENGINE_HOST="${VOICEVOX_ENGINE_HOST:-127.0.0.1}"
VOICEVOX_ENGINE_PORT="${VOICEVOX_ENGINE_PORT:-50021}"
LISTEND_STT_BACKEND="${LISTEND_STT_BACKEND:-faster-whisper}"
LISTEND_WAKE_BACKEND="${LISTEND_WAKE_BACKEND:-livekit}"
LISTEND_WAKE_MODEL_PATH="${LISTEND_WAKE_MODEL_PATH:-}"
LISTEND_WAKE_PROMPT_AUDIO="${LISTEND_WAKE_PROMPT_AUDIO:-}"
LISTEND_WAKE_WORDS="${LISTEND_WAKE_WORDS:-}"
LISTEND_DISPATCH_TIMEOUT_SEC="${LISTEND_DISPATCH_TIMEOUT_SEC:-}"

print_header

if [[ -d "$WORKSPACE" ]]; then
    ok "workspace: $WORKSPACE"
else
    fail "workspace not found: $WORKSPACE"
fi

if [[ -n "$ENV_FILE" ]]; then
    ok ".env loaded: $ENV_FILE"
else
    warn ".env not found; defaults are in use"
fi

check_git_env "$WORKSPACE"

info "engine: $ENGINE"
info "model: ${MODEL:-"(default)"}"
info "codex model: ${CODEX_MODEL:-"(Codex CLI default)"}"
info "codex profile: ${CODEX_PROFILE:-"(Codex CLI default)"}"
info "codex reasoning effort: ${CODEX_REASONING_EFFORT:-"(Codex CLI default)"}"
info "codex bypass sandbox: $CODEX_BYPASS_SANDBOX"

check_agent_commands "$ENGINE"
check_command "ffmpeg" "ffmpeg"
check_command "python3" "python3"
check_command "uv" "uv"
check_executable "zunda" "$SCRIPT_DIR/zunda"
check_executable "tapovoice" "$SCRIPT_DIR/tapovoice"
check_livekit_wakeword

case "$ENGINE" in
    auto|codex|claude|opencode)
        ok "engine value: $ENGINE"
        ;;
    *)
        fail "engine value is unsupported: $ENGINE"
        ;;
esac

check_codex_model "$CODEX_MODEL"
check_codex_profile "$CODEX_PROFILE"

if [[ -n "$CODEX_REASONING_EFFORT" ]]; then
    case "$CODEX_REASONING_EFFORT" in
        low|medium|high|xhigh)
            ok "codex reasoning effort value: $CODEX_REASONING_EFFORT"
            ;;
        *)
            warn "codex reasoning effort value is unsupported: $CODEX_REASONING_EFFORT"
            ;;
    esac
fi

VOICEVOX_URL="http://${VOICEVOX_ENGINE_HOST}:${VOICEVOX_ENGINE_PORT}/version"
if output="$(http_probe "$VOICEVOX_URL" 2 2>&1)"; then
    ok "VOICEVOX: $VOICEVOX_URL ($output)"
else
    warn "VOICEVOX: cannot reach $VOICEVOX_URL ($output)"
fi

GO2RTC_URL="http://${GO2RTC_HOST}:${GO2RTC_API_PORT}/api/streams"
    if output="$(http_probe "$GO2RTC_URL" 2 2>&1)"; then
    ok "go2rtc: $GO2RTC_URL"
    if [[ "$VERBOSE" == true ]]; then
        info "go2rtc response received (body hidden because it may contain stream credentials)"
    fi
else
    warn "go2rtc: cannot reach $GO2RTC_URL ($output)"
fi

info "STT backend: $LISTEND_STT_BACKEND"
info "dispatch timeout: ${LISTEND_DISPATCH_TIMEOUT_SEC:-"(default)"}"

if [[ "$CHECK_SERVICES" == true ]]; then
    if command -v systemctl >/dev/null 2>&1; then
        if state="$(systemctl --user is-active yatagarasu.service 2>/dev/null)"; then
            ok "yatagarasu.service: $state"
        else
            warn "yatagarasu.service: ${state:-not active}"
        fi

        if state="$(systemctl --user is-active go2rtc.service 2>/dev/null)"; then
            ok "go2rtc.service: $state"
        else
            warn "go2rtc.service: ${state:-not active}"
        fi
    else
        warn "systemctl: command not found"
    fi
fi

if [[ "$CHECK_LOGS" == true ]]; then
    if command -v journalctl >/dev/null 2>&1; then
        logs="$(journalctl --user -u yatagarasu.service -n 120 --no-pager 2>/dev/null || true)"
        if [[ -z "$logs" ]]; then
            warn "recent logs: no yatagarasu.service logs found"
        elif grep -Eiq 'Codex CLI error|Claude Code.*failed|dispatch failed|dispatch timed out|Traceback|ERROR' <<<"$logs"; then
            warn "recent logs: error-like entries found"
            if [[ "$VERBOSE" == true ]]; then
                grep -Ei 'Codex CLI error|Claude Code.*failed|dispatch failed|dispatch timed out|Traceback|ERROR' <<<"$logs" | tail -n 10
            fi
        else
            ok "recent logs: no obvious errors in last 120 lines"
        fi
    else
        warn "journalctl: command not found"
    fi
fi

printf '\nSummary: %d fail, %d warn\n' "$FAIL_COUNT" "$WARN_COUNT"

if [[ "$FAIL_COUNT" -gt 0 ]]; then
    exit 1
fi

exit 0
